#!/usr/bin/env bash
# stt-toggle — press once: start recording; press again: transcribe via
# OpenRouter and copy the text to the Wayland clipboard.
set -uo pipefail

CONFIG="${STT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wayland-stt/config}"
[[ -r $CONFIG ]] && . "$CONFIG"

: "${STT_MODEL:=microsoft/mai-transcribe-2}"
: "${STT_LANGUAGE:=}"                       # empty = auto-detect
: "${STT_PHRASES:=}"                        # comma-separated terms to bias recognition towards
: "${STT_API_URL:=https://openrouter.ai/api/v1/audio/transcriptions}"
: "${STT_RECORDER:=pw-record}"
: "${STT_MAX_SECONDS:=600}"                 # safety stop for forgotten recordings
: "${STT_FALLBACK_MODEL=openai/gpt-4o-mini-transcribe}"  # tried once retries are exhausted; empty = off
: "${STT_RETRIES:=5}"                       # retries on HTTP 429/5xx (waits: Retry-After, else 2,4,8,… s)
: "${STT_CLIP:=wl-copy}"
: "${STT_LOCAL_BIN:=nemo-speech}"           # `stt-toggle --local`: private mode, nothing leaves the machine
: "${STT_LOCAL_MODEL:=parakeet-tdt}"

STATE="${XDG_RUNTIME_DIR:-/tmp}/wayland-stt"
PID="$STATE/rec.pid"
WAV="$STATE/rec.wav"
OGG="$STATE/rec.ogg"
BUSY="$STATE/busy"
REQ="$STATE/req.json"
HDR="$STATE/resp.hdr"
MODE="$STATE/mode"   # cloud|local, fixed by the press that starts the recording
TXT="$STATE/local.txt"
NID="$STATE/notify.id"
mkdir -p -m 700 "$STATE"

# Only results and errors notify; GNOME's top-bar mic indicator shows an active recording.
# Each notification replaces the previous one (-r), so the tray holds one entry, not one per
# dictation. Avoid "low" urgency (no banner), desktop-entry and -e (both suppress it on GNOME 50).
notify() {
  local id; id=$(cat "$NID" 2>/dev/null)
  notify-send -a "Speech-to-Text" -i audio-input-microphone -u "$1" -p ${id:+-r "$id"} \
    "$2" "${3:-}" >"$NID.tmp" 2>/dev/null && mv "$NID.tmp" "$NID"
  rm -f "$NID.tmp"
}

fail() { notify critical "Transkription fehlgeschlagen" "$1"; echo "stt-toggle: $1" >&2; rm -f "$BUSY" "$REQ" "$HDR" "$TXT"; exit 1; }

start() {
  command -v "$STT_RECORDER" >/dev/null || fail "$STT_RECORDER nicht gefunden"
  rm -f "$WAV" "$OGG"
  echo "$1" >"$MODE"
  setsid timeout "$STT_MAX_SECONDS" "$STT_RECORDER" --rate 16000 --channels 1 "$WAV" </dev/null >/dev/null 2>&1 &
  echo $! >"$PID"
}

# POST $REQ, retrying 429/5xx; leaves the result in the caller's $resp and $code.
post_with_retries() {
  local wait attempt=0
  while :; do
    resp=$(curl -sS --max-time 120 -D "$HDR" -w '\n%{http_code}' "$STT_API_URL" \
      -H "Authorization: Bearer $OPENROUTER_API_KEY" -H 'Content-Type: application/json' \
      --data-binary @"$REQ" 2>&1) \
      || fail "Netzwerkfehler: ${resp##*$'\n'}"
    code=${resp##*$'\n'}; resp=${resp%$'\n'*}
    [[ $code == 429 || $code == 5?? ]] && (( attempt < STT_RETRIES )) || break
    wait=$(awk 'tolower($1) == "retry-after:" {gsub(/\r/, "", $2); w = $2} END {print w}' "$HDR")
    [[ $wait =~ ^[0-9]+$ ]] || wait=$(( 2 ** (attempt + 1) ))
    (( wait > 60 )) && wait=60
    ((attempt++))
    notify normal "⏳ HTTP $code, neuer Versuch in ${wait}s" "Versuch $attempt von $STT_RETRIES"
    echo "stt-toggle: HTTP $code ($(jq -r .model "$REQ")), Versuch $attempt/$STT_RETRIES in ${wait}s" >&2
    sleep "$wait"
    touch "$BUSY"   # keep the lock fresh so a press during a long retry isn't treated as stale
  done
}

# Sets the caller's $text from the OpenRouter API.
transcribe_cloud() {
  [[ -n ${OPENROUTER_API_KEY:-} ]] || fail "OPENROUTER_API_KEY fehlt in $CONFIG"

  # Opus shrinks the upload ~10x vs. WAV; fall back to WAV if ffmpeg is missing.
  local file=$WAV
  if command -v ffmpeg >/dev/null && ffmpeg -loglevel error -y -i "$WAV" -c:a libopus -b:a 24k "$OGG"; then
    file=$OGG
  fi

  # JSON body (base64 audio) because keyword biasing needs nested provider options.
  # phraseList is Azure's format (MAI-Transcribe); other providers ignore it.
  base64 -w0 "$file" | jq -Rs --arg m "$STT_MODEL" --arg f "${file##*.}" \
      --arg l "$STT_LANGUAGE" --arg p "$STT_PHRASES" '
    ($p | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $ph
    | {model: $m, input_audio: {data: ., format: $f}}
    + (if $l != "" then {language: $l} else {} end)
    + (if $ph != [] then {provider: {options: {azure: {phraseList: {phrases: $ph}}}}} else {} end)' >"$REQ" \
    || fail "Konnte Anfrage nicht erstellen"

  local resp code
  post_with_retries
  if [[ $code == 429 || $code == 5?? ]] && [[ -n $STT_FALLBACK_MODEL && $STT_FALLBACK_MODEL != "$STT_MODEL" ]]; then
    notify normal "⏳ $STT_MODEL nicht erreichbar (HTTP $code)" "Weiche auf $STT_FALLBACK_MODEL aus"
    jq --arg m "$STT_FALLBACK_MODEL" '.model = $m' "$REQ" >"$REQ.tmp" && mv "$REQ.tmp" "$REQ" \
      || fail "Konnte Fallback-Anfrage nicht erstellen"
    post_with_retries
  fi
  [[ $code == 200 ]] || fail "HTTP $code: $(jq -r '.error.message // .' <<<"$resp" 2>/dev/null | head -c 200)"
  text=$(jq -r '.text // empty' <<<"$resp" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
}

# Sets the caller's $text from a local model; no network, no fallback.
transcribe_local() {
  command -v "$STT_LOCAL_BIN" >/dev/null || fail "$STT_LOCAL_BIN nicht gefunden (lokaler Modus)"
  "$STT_LOCAL_BIN" transcribe "$WAV" -m "$STT_LOCAL_MODEL" -o "$TXT" >/dev/null 2>"$TXT.err" \
    || fail "Lokale Transkription fehlgeschlagen: $(tail -c 200 "$TXT.err")"
  text=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' "$TXT")
}

stop_and_transcribe() {
  local pid; pid=$(cat "$PID"); rm -f "$PID"
  touch "$BUSY"
  kill -INT "$pid" 2>/dev/null
  for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill -0 "$pid" 2>/dev/null && kill -TERM "$pid"

  [[ -s $WAV ]] || fail "Keine Audiodaten aufgenommen"
  local text mode; mode=$(cat "$MODE" 2>/dev/null)
  if [[ $mode == local ]]; then transcribe_local; else transcribe_cloud; fi
  [[ -n $text ]] || fail "Leeres Transkript"

  printf %s "$text" | "$STT_CLIP" || fail "Konnte nicht in die Zwischenablage kopieren ($STT_CLIP)"
  notify normal "✅ In Zwischenablage kopiert$([[ $mode == local ]] && echo " (lokal)")" "$(head -c 200 <<<"$text")"
  [[ -t 1 ]] && printf '%s\n' "$text"   # not via the shortcut: stdout would land in the journal
  rm -f "$BUSY" "$WAV" "$OGG" "$REQ" "$HDR" "$TXT" "$TXT.err" "$MODE"
}

if [[ -e $BUSY ]] && (( $(date +%s) - $(stat -c %Y "$BUSY") < 180 )); then
  notify normal "⏳ Transkription läuft noch …"; exit 0
fi
if [[ -s $PID ]] && kill -0 "$(cat "$PID")" 2>/dev/null; then
  stop_and_transcribe
elif [[ -s $PID && -s $WAV ]]; then
  stop_and_transcribe   # recorder hit STT_MAX_SECONDS; still send what we have
else
  start "$([[ ${1:-} == --local ]] && echo local || echo cloud)"
fi
